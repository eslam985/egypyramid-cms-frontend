{
    "headers": [
        {
            "source": "/index.html",
            "headers": [
                {
                "key": "Cache-Control",
                "value": "no-cache, no-store, must-revalidate"
                }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "https://egystreamer-egypyramid-cms-backend.hf.space/api/:path*"
        },
        {
        "source": "/(.*)",
        "destination": "/index.html"
        }
    ]
}
