{
  "extends": "@vue/tsconfig/tsconfig.json",
  "compilerOptions": {
    // 🌐 إعدادات البيئة المتوافقة 100% مع Vite و Vue 3
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "lib": ["esnext", "dom"],
    "esModuleInterop": true,
    "types": ["vite/client", "node"],
    "allowJs": true,

    // 🔒 خيارات الفحص الصارم والأمان
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "allowUnreachableCode": false,
  "exactOptionalPropertyTypes": false,
    // ⚡ إعدادات التوافق مع Vite
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    
    // 🔗 اختصار المسارات المباشر بدون baseUrl
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "vite.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}